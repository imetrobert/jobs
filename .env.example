# Frontend (build-time) — set as GitHub Actions secrets, used by deploy.yml
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Scan job (scripts/run-job-scan.js) — set as GitHub Actions secrets
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Scorer ----
# REQUIRED. The same key the blog pipeline uses. The whole system is sized to
# run inside Gemini's free tier — see SETUP.md for the request maths.
GEMINI_API_KEY=your-gemini-key

# OPTIONAL upgrade. Leave this unset and nothing about the system needs a paid
# Anthropic account, a Claude subscription, or a Claude Code seat. If it IS
# set, Claude is used for scoring instead of Gemini.
# ANTHROPIC_API_KEY=

# ---- Optional tuning (defaults are free-tier safe) ----
# GEMINI_RPM=8             requests/min ceiling; free tier allows ~10, stay under
# GEMINI_MODEL=            pin one model instead of the fallback chain
# SCORE_BATCH_SIZE=5       postings assessed per LLM call
# MAX_SCORES_PER_RUN=120   hard cap on postings scored in a single run

# ---- Job feeds ----
# All optional, but with none of them only ATS company boards work.
# Adzuna: free, self-serve at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: free key on request at https://jooble.org/api/about
JOOBLE_API_KEY=
# JSearch (RapidAPI) — optional, paid beyond a small free tier. This is the
# one source that surfaces LinkedIn/Indeed-sourced rows.
JSEARCH_RAPIDAPI_KEY=
